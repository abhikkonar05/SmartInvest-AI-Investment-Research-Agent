# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js and other build outputs
.next/
out/
dist/
build/
bin/
obj/

# testing and coverage
coverage/

# misc system/IDE files
.DS_Store
*.pem
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts
